# 비워두면 로컬 개발용 DB(.pglite 폴더)를 자동으로 씁니다.
# 배포할 때는 Neon의 연결 문자열(pooled)을 넣으세요.
DATABASE_URL=

# 웹 푸시 알림. 만드는 방법은 README의 "알림 설정"을 보세요. 비워두면 알림만 꺼집니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:12jason@naver.com
# 카카오 로그인. 둘 다 있어야 "카카오로 시작하기" 버튼이 보입니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# Vercel Cron이 /api/cron/reminders를 부를 때 쓰는 비밀값
CRON_SECRET=
